# ===========================================
# FRONTEND - Variables de Entorno
# ===========================================
# Copia este archivo como .env.local y completa los valores

# API Backend URL
# Local: http://localhost:8000/api
# Producción: https://tu-backend.onrender.com/api
NEXT_PUBLIC_API_URL=

# Media URL (paths relativos legacy, ej. /media/...)
# Con Supabase Storage el API ya devuelve URLs absolutas https://...supabase.co/...
# y getMediaUrl las usa tal cual; esta var solo importa para URLs relativas antiguas.
# Local: http://localhost:8000
# Producción: https://tu-backend.onrender.com
NEXT_PUBLIC_MEDIA_URL=
