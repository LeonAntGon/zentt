# ===========================================
# FRONTEND - Variables de Entorno
# ===========================================
# Copia este archivo como .env.local y completa los valores

# API Backend URL
# Local: http://localhost:8000/api
# Producción: https://tu-backend.onrender.com/api
NEXT_PUBLIC_API_URL=

# Media URL (paths relativos legacy, ej. /media/...)
# Con Supabase Storage el API ya devuelve URLs absolutas https://...supabase.co/...
# y getMediaUrl las usa tal cual; esta var solo importa para URLs relativas antiguas.
# Local: http://localhost:8000
# Producción: https://tu-backend.onrender.com
NEXT_PUBLIC_MEDIA_URL=

# Dominio canónico de los sitios públicos y enlaces del panel.
NEXT_PUBLIC_PUBLIC_SITE_URL=https://zentt.agency

# Google Analytics 4 Measurement ID
# Example: G-XXXXXXXXXX
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Mostrar el botón de checkout internacional (el token y los IDs Polar viven solo en Django/Render).
NEXT_PUBLIC_POLAR_CHECKOUT_ENABLED=false
NEXT_PUBLIC_POLAR_PRICE_PRO_USD=9.99
NEXT_PUBLIC_POLAR_PRICE_COMPLEJO_USD=19.99
