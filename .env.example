# ===========================================
# FRONTEND - Variables de Entorno
# ===========================================
# Copia este archivo como .env.local y completa los valores

# API Backend URL (sin /api al final, se agrega automáticamente)
# Local: http://localhost:8000/api
# Producción: https://tu-backend.railway.app/api
NEXT_PUBLIC_API_URL=

# Media URL (para imágenes subidas al backend)
# Local: http://localhost:8000
# Producción: https://tu-backend.railway.app
NEXT_PUBLIC_MEDIA_URL=
